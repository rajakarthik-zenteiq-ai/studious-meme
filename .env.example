# Linode Object Storage Configuration
# Replace with your actual Linode Object Storage credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_ENDPOINT_URL=https://in-maa-1.linodeobjects.com
AWS_BUCKET_NAME=mcp

# Instructions:
# 1. Get your Linode Object Storage credentials from the Linode Cloud Manager
# 2. Replace the placeholder values above with your actual credentials
# 3. Rename this file to .env (remove the .example extension)
# 4. The application will automatically load these environment variables
